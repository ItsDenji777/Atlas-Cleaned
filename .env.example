# Local use: leave PUBLIC_ORIGIN empty, then open http://localhost:8080.
NODE_ENV=production
HOST=127.0.0.1
PORT=8080
WISP_ALLOW_PRIVATE_IPS=false
ENABLE_IPV4_MIRROR=false
PUBLIC_ORIGIN=
ATLAS_PORT=8080

# Public HTTPS: set BOTH values to your own hostname, then enable the https profile.
# PUBLIC_ORIGIN=https://atlas.example.com
ATLAS_DOMAIN=atlas.example.com
